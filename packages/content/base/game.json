{
  "schemaVersion": 1,
  "sim": { "tickRateHz": 60 },
  "logging": { "hashEverySec": 1, "events": ["RunStarted", "RunPhaseChanged", "TrainSwitched", "BoardingAttempt", "DamageDealt", "CommandRejected", "HeatChanged", "RunEnded", "PersistentChanged", "LootPickedUp", "LootRefused", "LootRevealed", "LootDropped", "SearchCancelled", "GuardStateChanged", "PlayerSpotted", "ThrownOff", "HorseBoosted"] },
  "player": { "speedTilesPerSec": 8, "crouch": { "speedScale": 0.25 } },
  "world": { "mode": "separate" },
  "horse": {
    "maxSpeed": 14, "accel": 7, "brake": 12, "dragTilesPerSec2": 3, "cruiseTargetRateTilesPerSec2": 10,
    "slowZoneSpeedScale": 0.5, "waterSpeedScale": 0.25, "turnRateDegPerSec": 120, "steering": "heading", "throttleModel": "hold",
    "boost": { "enabled": true, "durationSec": 1.5, "topSpeedScale": 1.4, "cooldownSec": 6, "accelTilesPerSec2": 20 }
  },
  "ai": {
    "guardCatch": "heat-only",
    "patrolSpeedTilesPerSec": 1.5, "patrolPauseSec": 1.5, "chaseSpeedTilesPerSec": 4, "turnRateDegPerSec": 240,
    "sight": { "rangeTiles": 7, "coneHalfAngleDeg": 40, "crouchCoverMin": 0.4 },
    "noise": { "walkRadiusTiles": 1.5, "runRadiusTiles": 5, "crouchRadiusTiles": 0.3 },
    "alertAfterSec": 1, "calmSec": 4, "alertCalmSec": 6, "loseSightSec": 3, "catchRangeTiles": 0.8,
    "thrownOffLootShare": 0.5
  },
  "commit": { "rangeTiles": 12, "timerSec": 2, "closeRangeTiles": 4, "promptSwitch": true, "switchTimerSec": 3, "cancelInPlace": true, "switchRangeTiles": 30, "autoSwitch": false, "autoSwitchMarginTiles": 4 },
  "boarding": {
    "rangeTiles": 2,
    "speedToleranceTilesPerSec": 2,
    "meter": { "sweepPeriodSec": 1.3, "matchedSweepPeriodSec": 1.85, "zoneWidths": [0.03, 0.15] },
    "failure": { "stunSec": 1.5, "damageFraction": 0.15, "horseSpeedScale": 0.5 },
    "landing": { "stumbleSec": 1.5, "stumbleSpeedScale": 0.33 }
  },
  "health": { "max": 100 },
  "collision": { "damageFraction": 0.45, "obstacleDamageFraction": 0.1, "scrapeDamageFraction": 0.01, "minImpactTilesPerSec": 2, "fullImpactTilesPerSec": 8, "cooldownSec": 1 },
  "playtest": { "quickRetry": true, "quickRetryGapTiles": 60, "debugHeatStep": 10 },
  "countdown": { "enabled": true, "startsAt": "commit", "scale": 1, "graceSec": 3 },
  "heat": {
    "maxHeat": 100,
    "heatDrainFactor": 1.0,
    "sources": { "shotFired": 2, "alarmRaised": 15, "playerSpotted": 5, "actorKilled": 8, "lootTaken": 1, "timeAboardPerSec": 0.33 },
    "boardingResistanceAt": null
  },
  "loot": { "densityScale": 1 },
  "trains": {
    "mail-express": {
      "name": "Mail Express",
      "route": "main",
      "speedTilesPerSec": 9,
      "engine": "engine",
      "carType": "mail-car",
      "carCount": 3,
      "caboose": "caboose",
      "requireSideDoors": "both",
      "countdown": { "baseSec": 150 },
      "loot": { "table": "mail-small-items", "density": 0.6 },
      "guards": { "base": 0, "perCar": 0.67 },
      "verbs": ["search"]
    },
    "blank": {
      "name": "Blank train",
      "route": "main",
      "speedTilesPerSec": 9,
      "engine": "engine",
      "carType": "blank-car",
      "carCount": 3,
      "caboose": "caboose",
      "requireSideDoors": "both",
      "countdown": { "baseSec": 150 },
      "verbs": []
    }
  },
  "trainMix": { "mode": "map", "mailTrain": "mail-express", "blankTrain": "blank", "trainCount": 3, "blankShare": 0 },
  "carry": { "limitEnabled": true, "slowdownEnabled": true, "maxWeight": 10, "maxItems": 20, "slowdownFromWeight": 6, "minSpeedScale": 0.5 },
  "verbs": { "search": { "searchTimeSec": 1.2, "hiddenSearchTimeSec": 1.8, "timeScale": 1, "walkSpeedScale": 0.3, "cancelRangeTiles": 1.5, "reachTiles": 1.2, "hiddenLoot": true } },
  "hud": { "showTrainNames": false },
  "outcomePolicy": {
    "died": { "bankRunLoot": false, "wantedDelta": 0, "bankLossFraction": 0, "reset": [] },
    "cancelled": { "bankRunLoot": false, "wantedDelta": 0 },
    "expired": { "bankRunLoot": false, "wantedDelta": 1 }
  }
}
